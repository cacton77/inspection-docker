# colcon workspace, mounted at /workspaces/ros2_ws. Only the vcstool manifest
# is tracked: the cloned packages, colcon's outputs (build/, install/, log/)
# and runtime files written in the workspace root (cyclonedds.log, *.yaml
# dumps, ...) are not.
ros2_ws/*
!ros2_ws/src/
ros2_ws/src/*
!ros2_ws/src/shared.repos
data/*
!data/data.repos
!data/servo*
models/*
!models/models.repos
.claude/
.vscode/
arduino/bin/
arduino/data/
arduino/downloads/
arduino/user/
arduino/tmp/
arduino/extra-libraries/

# Generated by install.sh from .env (per-sketch MICROROS_DOMAIN_ID)
**/domain_id.h

.env

# 3DX catalog cache: SQLite index, STEP/thumbnail/plan/result artifacts.
# Host-mounted into the container; entirely reproducible from the tenant.
catalog/
