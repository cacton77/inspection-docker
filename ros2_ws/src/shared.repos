repositories:
    Inspection_Cell:
        type: git
        url: https://github.com/DevanshB99/Inspection_Cell
        version: main
    
    Inspection_Control:
        type: git
        url: https://github.com/antara1005/Inspection_Control
        version: main

    Turntable_ROS2_Driver:
        type: git
        url: https://github.com/DevanshB99/Turntable_ROS2_Driver.git
        version: ESP32

    ViewpointGeneration:
        type: git
        url: https://github.com/cacton77/ViewpointGeneration
        version: main

    http_image_publisher:
        type: git
        url: https://github.com/cacton77/http_image_publisher
        version: main

    # Zivid 2+ MR60 driver. Pin to a release: each one supports a fixed range
    # of Zivid SDK versions, which must match ZIVID_SDK_VERSION in
    # docker/Dockerfile.jazzy (v3.4.0 -> SDK 2.15-2.18).
    zivid-ros:
        type: git
        url: https://github.com/zivid/zivid-ros.git
        version: v3.4.0
