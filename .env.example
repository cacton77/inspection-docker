# Example environment for inspection-docker.
#
# Copy to `.env` and fill in the values for your deployment. `.env` is
# gitignored because it holds the 3DEXPERIENCE password -- never commit it.
#
#   cp .env.example .env && $EDITOR .env

# --- Container / ROS 2 -------------------------------------------------

CONTAINER_NAME=inspection-docker
ROS_DOMAIN_ID=9
ROS_DISTRO=jazzy
# rmw_cyclonedds_cpp (default) or rmw_fastrtps_cpp
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
COMPOSE_PROFILE=nvidia
COMPOSE_SERVICE=inspection_nvidia
USE_SERVICE=true

# --- 3DEXPERIENCE connection -------------------------------------------

# IAM / passport host you authenticate against. On cloud tenants this is
# frequently in a different region from the data services below -- that is
# expected; the CAS login redirects between them.
DX_PASSPORT_URL=https://r1132100093385-eu1-academia.iam.3dexperience.3ds.com

# 3DSpace host serving the REST APIs (note the trailing /enovia).
DX_SPACE_URL=https://r1132100093385-usw2-academia-space.3dexperience.3ds.com/enovia

# Platform tenant id. Cloud deployments require it as a `tenant=` query
# parameter on essentially every API call. Find it in the URL of any 3DX
# request via browser DevTools.
DX_TENANT=R1132100093385

DX_USERNAME=your-3dx-login
DX_PASSWORD=your-3dx-password

# SecurityContext triplet, INCLUDING the `ctx::` prefix:
#   ctx::Role.Organization.CollabSpace
# Use the internal role name (VPLMProjectLeader, VPLMCreator, ...), not the
# display name. Discover the exact value for your account with:
#   python -m viewpoint_generation.catalog.sync --contexts
# Quote it: several scripts in this repo `source .env`, and the spaces in the
# organization / collaborative-space names would otherwise truncate the value.
# docker-compose strips the surrounding quotes.
DX_SECURITY_CONTEXT="ctx::VPLMProjectLeader.Company Name.Colin Acton Space"

# --- Catalog scope and cadence -----------------------------------------

# Scope of the parts catalog. When this matches the title of a 3DX bookmark,
# that bookmark's contents become the catalog -- curate the set in 3DX and the
# cell follows it. Otherwise it is used as a search string ('*' = everything
# the security context can read).
DX_BOOKMARK_SCOPE="Inspection Parts"

# Keep only these maturity states (comma separated, empty = all).
# DX_MATURITY_FILTER=RELEASED,IN_WORK

# Keep only items in this collaborative space (empty = all readable spaces).
# A tenant-wide search returns demo and template content from other spaces,
# so setting this is usually what you want.
DX_COLLAB_SPACE="Colin Acton Space"

# Seconds between background incremental syncs (0 disables the timer).
CATALOG_SYNC_INTERVAL=300

# Catalog cache locations INSIDE the container. These correspond to the
# ./catalog host directory mounted by docker-compose.yaml.
CATALOG_ROOT=/workspaces/shared_ws/catalog
# CATALOG_DB_PATH=/workspaces/shared_ws/catalog/catalog.db
# CATALOG_STEP_DIR=/workspaces/shared_ws/catalog/steps
# CATALOG_THUMB_DIR=/workspaces/shared_ws/catalog/thumbnails
# CATALOG_PLAN_DIR=/workspaces/shared_ws/catalog/plans
# CATALOG_RESULT_DIR=/workspaces/shared_ws/catalog/results

# Identifier for this inspection cell, stamped into uploaded plan/result
# envelopes so multi-cell deployments stay traceable.
CELL_ID=alpha

# Anomaly score above which an uploaded inspection result auto-creates a 3DX
# Issue for the NCR workflow.
# CATALOG_NCR_THRESHOLD=0.8

# --- Part picker UI ----------------------------------------------------

PICKER_PORT=5050

# --- Event-driven sync (optional) --------------------------------------

# STOMP/AMQP bridge relaying 3DX platform events. When unset, the catalog
# falls back to timer-based polling on CATALOG_SYNC_INTERVAL.
# DX_JMS_BROKER_URL=stomp://broker:61613
