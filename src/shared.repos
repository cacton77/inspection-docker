repositories:
    Inspection_Cell:
        type: git
        url: https://github.com/DevanshB99/Inspection_Cell
        version: main
    
    Inspection_Control:
        type: git
        url: https://github.com/antara1005/Inspection_Control
        version: main

    Turntable_ROS2_Driver:
        type: git
        url: https://github.com/DevanshB99/Turntable_ROS2_Driver.git
        version: ESP32

    ViewpointGeneration:
        type: git
        url: https://github.com/cacton77/ViewpointGeneration
        # plm-bridge: depends on plm_bridge below (switch back to main once merged)
        version: plm-bridge

    # PLM parts catalog, part picker, STEP loader (plm_interfaces, cad_loader,
    # plm_bridge, plm_bridge_ros). Private: vcs import needs GitHub access.
    plm_bridge:
        type: git
        url: https://github.com/cacton77/plm_bridge
        version: main

    http_image_publisher:
        type: git
        url: https://github.com/cacton77/http_image_publisher
        version: main
